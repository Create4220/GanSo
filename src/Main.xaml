<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GanSo · 专注伙伴" Width="820" Height="560" MinWidth="760" MinHeight="540" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="White">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#20FFFFFF"/><Setter Property="Foreground" Value="#534B78"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#50FFFFFF" BorderThickness="0.7" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#DFDCEB"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/></Style>
  <SolidColorBrush x:Key="PopupBackground" Color="#FF252529"/>
  <SolidColorBrush x:Key="ThemeForeground" Color="White"/>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource PopupBackground}"/><Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/><Setter Property="Padding" Value="8"/></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><Border Background="#18000000" BorderBrush="#60808080" BorderThickness="1" CornerRadius="7"/>
     <Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <TextBox x:Name="PART_EditableTextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}" BorderThickness="0" FontSize="{TemplateBinding FontSize}" VerticalContentAlignment="Center" Padding="6,2"/>
      <ToggleButton Grid.Column="1" Focusable="False" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
     </Grid>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource PopupBackground}" BorderBrush="#80808080" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="16" Background="Transparent">
  <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
  <Image x:Name="Character" Stretch="Uniform" Margin="0,18,18,18" IsHitTestVisible="False"/>
  <Border x:Name="GlassPanel" Grid.Column="1" CornerRadius="30" BorderThickness="1" Padding="23,17,23,17">
   <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0FFFFFF" Offset="0"/><GradientStop Color="#35FFFFFF" Offset="0.48"/><GradientStop Color="#C0FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#04FFFFFF" Offset="0.45"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
   <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="#142026"/></Border.Effect>
   <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="48"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="50"/><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="22"/></Grid.RowDefinitions>
    <Grid x:Name="DragArea" Background="Transparent"><TextBlock Text="GanSo" FontFamily="Segoe UI" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Pin" Content="置顶" FontSize="10" Padding="9,6"/><Button x:Name="Minimize" Content="—" Padding="10,6"/><Button x:Name="CloseButton" Content="×" Padding="10,6"/></StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,3,0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ModeDown" Content="倒计时" FontSize="13" Padding="12,5" Height="34" VerticalContentAlignment="Center"/><Button x:Name="ModeUp" Grid.Column="1" Content="正计时" FontSize="13" Padding="12,5" Height="34" VerticalContentAlignment="Center"/></Grid>
    <Grid Grid.Row="2" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ComboBox x:Name="TaskName" IsEditable="True" IsTextSearchEnabled="False" FontSize="16" Height="40" MaxDropDownHeight="220" VerticalContentAlignment="Center" ToolTip="输入任务名称，或从清单选择"/><Button Grid.Column="1" x:Name="SaveTask" Content="＋" FontSize="20" Padding="4,2" Height="38" ToolTip="保存任务"/></Grid>
    <StackPanel Grid.Row="3" VerticalAlignment="Center"><TextBlock x:Name="Clock" Text="25:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" FontSize="68" HorizontalAlignment="Center"/><ProgressBar x:Name="Progress" Height="3" BorderThickness="0" Maximum="1" Margin="4,9,4,4"/><TextBlock x:Name="Status" Text="准备好了，就开始吧" HorizontalAlignment="Center" FontSize="11" Opacity="0.7" Margin="0,6"/><TextBlock x:Name="TotalFocus" Text="累计 0h00min" FontSize="11" HorizontalAlignment="Center" Opacity="0.65" Margin="0,2,0,7"/></StackPanel>
    <StackPanel x:Name="DurationInputs" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,8"><TextBox x:Name="Minutes" Text="25" Width="43" MaxLength="3" TextAlignment="Center"/><TextBlock Text=" 分 " VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="Seconds" Text="00" Width="40" MaxLength="2" TextAlignment="Center"/><TextBlock Text=" 秒  " VerticalAlignment="Center" FontSize="11"/><Button x:Name="Preset5" Content="5′" Padding="9,8" FontSize="11"/><Button x:Name="Preset25" Content="25′" Padding="9,8" FontSize="11"/><Button x:Name="Preset45" Content="45′" Padding="9,8" FontSize="11"/></StackPanel>
    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Button x:Name="StartPause" Content="开始专注" FontSize="14" Padding="12,10"/><Button Grid.Column="1" x:Name="Finish" Content="结束" FontSize="12" Padding="8,10" ToolTip="结束本次正计时并保存专注时长"/><Button Grid.Column="2" x:Name="Reset" Content="重置" FontSize="12" Padding="7,10"/></Grid>
    <UniformGrid Grid.Row="6" Columns="3" Margin="0,4,0,0"><Button x:Name="Shuffle" Content="↻ 换一张" FontSize="11" Padding="5,7"/><Button x:Name="Tasks" Content="任务清单" FontSize="11" Padding="5,7"/><Button x:Name="Settings" Content="设置" FontSize="11" Padding="5,7"/></UniformGrid>
    <CheckBox Grid.Row="7" x:Name="RandomCueToggle" Content="随机休息提示（3–5分钟）" FontSize="11" Margin="6,4,0,2" VerticalContentAlignment="Center" ToolTip="专注中随机播放所选提示音一次，提醒闭眼放松10秒；计时继续。结束时播放三次Codex提示音。间隔可在设置中调整。"/><TextBlock Grid.Row="8" x:Name="Today" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.6"/>
   </Grid>
  </Border>
  <Border Grid.Column="1" Margin="2" CornerRadius="28" BorderThickness="1" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#20FFFFFF" Offset="0"/><GradientStop Color="#02FFFFFF" Offset="0.38"/><GradientStop Color="#02FFFFFF" Offset="0.65"/><GradientStop Color="#60FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush></Border>
 </Grid>
</Window>
