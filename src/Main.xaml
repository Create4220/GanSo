<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GanSo · 专注伙伴" Width="440" Height="600" MinWidth="400" MinHeight="580" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="White">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#20FFFFFF"/><Setter Property="Foreground" Value="#534B78"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#50FFFFFF" BorderThickness="0.7" CornerRadius="18" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#DFDCEB"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/></Style>
  <SolidColorBrush x:Key="PopupBackground" Color="#FF252529"/>
  <SolidColorBrush x:Key="ThemeForeground" Color="White"/>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource PopupBackground}"/><Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/><Setter Property="Padding" Value="8"/></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><Border Background="#18000000" BorderBrush="#60808080" BorderThickness="1" CornerRadius="7"/>
     <Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <TextBox x:Name="PART_EditableTextBox" Background="Transparent" Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}" BorderThickness="0" FontSize="{TemplateBinding FontSize}" VerticalContentAlignment="Center" Padding="6,2"/>
      <ToggleButton Grid.Column="1" Focusable="False" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock Text="⌄" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
     </Grid>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource PopupBackground}" BorderBrush="#80808080" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="220"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="SummaryStyle" TargetType="Button"><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="CharacterStyle" TargetType="Button"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><Rectangle x:Name="PressShade" Fill="Black" Opacity="0" IsHitTestVisible="False"><Rectangle.OpacityMask><ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform"/></Rectangle.OpacityMask></Rectangle></Grid><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="PressShade" Property="Opacity" Value="0.18"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PressShade" Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="CompanionSurface" Margin="16">
  <Button x:Name="CharacterButton" Style="{StaticResource CharacterStyle}" Height="350" Margin="8,188,8,0" Panel.ZIndex="0" VerticalAlignment="Top" ToolTip="按住拖动位置"><Image x:Name="Character" Stretch="Uniform"/></Button>
  <Grid x:Name="GlassHost" Panel.ZIndex="10" VerticalAlignment="Top">
   <Border x:Name="GlassPanel" CornerRadius="30" BorderThickness="1" Padding="20,14">
    <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F0FFFFFF" Offset="0"/><GradientStop Color="#35FFFFFF" Offset="0.48"/><GradientStop Color="#C0FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#04FFFFFF" Offset="0.45"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background>
    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.18" Color="#142026"/></Border.Effect>
    <StackPanel>
     <Button x:Name="CompactToggle" Style="{StaticResource SummaryStyle}" AutomationProperties.Name="展开或收起控制区">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="BrandTitle" Text="GanSo" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold" Margin="6,3,12,0"/><TextBlock x:Name="TaskDisplay" Grid.Column="1" Text="自由专注" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,5,6,0"/><TextBlock x:Name="Disclosure" Grid.Column="2" Text="⌄" FontSize="16" Margin="0,0,6,0"/></Grid>
       <TextBlock Grid.Row="1" x:Name="Clock" Text="25:00" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" FontSize="68" HorizontalAlignment="Center"/>
       <ProgressBar Grid.Row="2" x:Name="Progress" Height="3" BorderThickness="0" Maximum="1" Margin="5,7,5,5"/>
      </Grid>
     </Button>
     <StackPanel x:Name="ControlsPanel" Visibility="Collapsed">
      <Grid x:Name="DragArea" Height="28" Margin="0,6,0,2" Background="Transparent"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Pin" Content="置顶" FontSize="10" Padding="9,4"/><Button x:Name="Minimize" Content="—" Padding="10,4"/><Button x:Name="CloseButton" Content="×" Padding="10,4"/></StackPanel></Grid>
      <UniformGrid Columns="2" Height="40"><Button x:Name="ModeDown" Content="倒计时" FontSize="13" Height="34" Padding="12,5"/><Button x:Name="ModeUp" Content="正计时" FontSize="13" Height="34" Padding="12,5"/></UniformGrid>
      <Grid Height="42" Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ComboBox x:Name="TaskName" IsEditable="True" IsTextSearchEnabled="False" FontSize="15" Height="36" MaxDropDownHeight="220" VerticalContentAlignment="Center" ToolTip="输入任务名称，或从清单选择"/><Button Grid.Column="1" x:Name="SaveTask" Content="＋" FontSize="20" Height="36" Padding="4,1" ToolTip="保存任务"/></Grid>
      <TextBlock x:Name="Status" Text="准备好了，就开始吧" HorizontalAlignment="Center" FontSize="10" Opacity="0.7" Margin="0,3,0,0"/>
      <TextBlock x:Name="TotalFocus" Text="累计 0h00min" FontSize="10" HorizontalAlignment="Center" Opacity="0.65" Margin="0,2,0,3"/>
      <StackPanel x:Name="DurationInputs" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,5"><TextBox x:Name="Minutes" Text="25" Width="43" MaxLength="3" TextAlignment="Center"/><TextBlock Text=" 分 " VerticalAlignment="Center" FontSize="11"/><TextBox x:Name="Seconds" Text="00" Width="40" MaxLength="2" TextAlignment="Center"/><TextBlock Text=" 秒  " VerticalAlignment="Center" FontSize="11"/><Button x:Name="Preset5" Content="5′" Padding="9,7" FontSize="11"/><Button x:Name="Preset25" Content="25′" Padding="9,7" FontSize="11"/><Button x:Name="Preset45" Content="45′" Padding="9,7" FontSize="11"/></StackPanel>
      <Grid Height="44"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions><Button x:Name="StartPause" Content="开始专注" FontSize="14" Padding="12,8"/><Button Grid.Column="1" x:Name="Finish" Content="结束" FontSize="12" Padding="8,8"/><Button Grid.Column="2" x:Name="Reset" Content="重置" FontSize="12" Padding="7,8"/></Grid>
      <UniformGrid Columns="3" Height="35"><Button x:Name="Shuffle" Content="↻ 换一张" FontSize="11" Padding="5,6"/><Button x:Name="Tasks" Content="任务清单" FontSize="11" Padding="5,6"/><Button x:Name="Settings" Content="设置" FontSize="11" Padding="5,6"/></UniformGrid>
      <CheckBox x:Name="RandomCueToggle" Content="随机休息提示（3–5分钟）" FontSize="11" Margin="6,5,0,3" VerticalContentAlignment="Center" ToolTip="只控制过程中的随机提示；完成时固定播放三次Codex提示音。"/>
      <TextBlock x:Name="Today" FontSize="10" HorizontalAlignment="Center" Opacity="0.6" Margin="0,4,0,0"/>
      <TextBlock x:Name="CharacterCaption" FontSize="11" HorizontalAlignment="Center" Opacity="0.72" Margin="0,8,0,0" Visibility="Collapsed"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <Border Margin="2" CornerRadius="28" BorderThickness="1" IsHitTestVisible="False"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#20FFFFFF" Offset="0"/><GradientStop Color="#02FFFFFF" Offset="0.38"/><GradientStop Color="#02FFFFFF" Offset="0.65"/><GradientStop Color="#60FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush></Border>
  </Grid>
 </Grid>
</Window>
